{
  "name": "openearth-xr",
  "private": false,
  "version": "0.3.0",
  "type": "module",
  "main": "./dist-lib/openearth.js",
  "module": "./dist-lib/openearth.js",
  "types": "./dist-lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/openearth.js"
    }
  },
  "files": [
    "dist-lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && npm run build:lib",
    "build:app": "tsc --noEmit && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build -c vite.lib.config.ts",
    "prepare": "npm run build:lib",
    "preview": "vite preview",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "devDependencies": {
    "@types/three": "^0.181.0",
    "@types/webxr": "^0.5.22",
    "typescript": "^5.8.3",
    "vite": "^6.2.2",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "dependencies": {
    "cesium": "^1.143.0",
    "three": "^0.181.0"
  }
}
